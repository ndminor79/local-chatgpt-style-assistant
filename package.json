{
  "name": "local-chatgpt-style-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:client": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "check:setup": "tsx scripts/setup-check.ts",
    "model:pull": "ollama pull qwen3:8b",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
